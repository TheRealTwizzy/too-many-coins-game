# Too Many Coins - tick worker environment
# Dokploy application: too-many-coins-worker (same image as the web app,
# start command /app/docker/worker-entrypoint.sh, replicas 1, no domain)
#
# Paste into the app's Environment tab and replace every CHANGE-ME.
# Comments are on their own lines on purpose: Dokploy keeps everything after
# "=" as the value, so never put a comment at the end of a value line.
# Reference: DEPLOY_DOKPLOY.md sections 4 and 8.

# Database: identical to the web service. The worker connects directly.
DB_HOST=tmc-db
DB_PORT=3306
DB_NAME=too_many_coins
DB_USER=tmc
DB_PASS=CHANGE-ME

# Timing. TMC_TICK_REAL_SECONDS must match the web service exactly.
TZ=UTC
TMC_TICK_REAL_SECONDS=5
TMC_TIME_SCALE=1
TMC_TICK_ON_REQUEST=false
TMC_WORKER_INTERVAL_SECONDS=5
TMC_WORKER_START_DELAY_SECONDS=2
TMC_WORKER_ERROR_BACKOFF_SECONDS=2

# Migrations are applied as a deploy step with php /app/tools/migrate.php
# (section 4.7). The worker opens the same Database connection as the web
# app, which auto-applies pending migrations unless this is false, so it must
# be off here too or a worker restart applies them on its own.
TMC_AUTO_SQL_MIGRATIONS=false
