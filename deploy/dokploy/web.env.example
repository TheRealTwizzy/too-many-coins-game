# Too Many Coins - web service environment
# Dokploy application: too-many-coins-test (public test lane)
#
# Paste into the app's Environment tab and replace every CHANGE-ME.
# Comments are on their own lines on purpose: Dokploy keeps everything after
# "=" as the value, so never put a comment at the end of a value line.
# Reference: DEPLOY_DOKPLOY.md section 4.

# Database: the Dokploy MySQL service in the same project (section 2, option A).
# DB_HOST is the service's internal name, not localhost and not the VPS IP.
DB_HOST=tmc-db
DB_PORT=3306
DB_NAME=too_many_coins
DB_USER=tmc
DB_PASS=CHANGE-ME

# Required. Generate with: openssl rand -hex 32
TMC_INIT_SECRET=CHANGE-ME

# Confirmation links in registration mail point here.
TMC_PUBLIC_BASE_URL=https://test.too-many-coins.com

# Timing. Must match the worker service exactly.
TZ=UTC
TMC_TICK_REAL_SECONDS=5
TMC_TIME_SCALE=1
TMC_TICK_ON_REQUEST=false

# Reverse proxy. Dokploy's Traefik sits on the project's Docker network, so a
# range is more durable than a single container address (section 4.2).
TMC_TRUST_PROXY_HEADERS=false
TMC_TRUSTED_PROXIES=172.16.0.0/12

# Migrations are applied as a deploy step with php /app/tools/migrate.php
# (section 4.7). Auto-apply on every request is off.
TMC_AUTO_SQL_MIGRATIONS=false

# Email (section 4.6). Signups cannot confirm without working SMTP.
# The SMTP host/port below are Hostinger's; change them for another provider.
# TMC_MAIL_FROM must be the same mailbox as TMC_SMTP_USER: Hostinger (and most
# providers) refuse to send as any other address.
# TMC_MAIL_DEV_LOG defaults to true, which logs mail instead of sending it;
# it must be false here or nobody can confirm an account.
TMC_MAIL_DEV_LOG=false
TMC_SMTP_HOST=smtp.hostinger.com
TMC_SMTP_PORT=587
TMC_SMTP_SECURE=tls
TMC_SMTP_USER=CHANGE-ME
TMC_SMTP_PASS=CHANGE-ME
TMC_MAIL_FROM=no-reply@too-many-coins.com
TMC_MAIL_FROM_NAME=Too Many Coins

# Diagnostics for the rollout checklist (section 11). Set to false afterwards.
TMC_RATE_LIMIT_DIAGNOSTICS=true
